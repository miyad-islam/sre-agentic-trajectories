    "type": "function",
    "function": {
      "name": "db_terminate_backend",
      "description": "Safely cancel a query (pg_cancel_backend) or terminate a blocking database connection (pg_terminate_backend).",
      "parameters": {
        "type": "object",
        "properties": {
          "database_name": {
            "type": "string",
